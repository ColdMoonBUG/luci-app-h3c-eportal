#!/bin/sh
[ "${IPKG_NO_SCRIPT}" = "1" ] && exit 0
[ -s ${IPKG_INSTROOT}/lib/functions.sh ] || exit 0
. ${IPKG_INSTROOT}/lib/functions.sh
default_postinst $0 $@

# Refresh LuCI menu cache so the new page shows up without a reboot.
# Only touch the running system, never the install root during image build.
[ -z "${IPKG_INSTROOT}" ] && rm -f /tmp/luci-indexcache.* /tmp/luci-modulecache/* 2>/dev/null

# (Re)start the service. This is a no-op when the service is disabled
# (enabled=0) or credentials are empty.
[ -z "${IPKG_INSTROOT}" ] && /etc/init.d/nbtverify restart 2>/dev/null

exit 0
